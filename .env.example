# --- APP PORTS ---
MAIN_SERVER_PORT=4000
SOCKET_SERVER_PORT=9002
PROXY_SERVER_PORT=7000

# --- AWS CONFIGURATION ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=vercel-builder-outputs

# --- AWS ECS (FOR MAIN SERVER) ---
ECS_CLUSTER_ARN=arn:aws:ecs:region:account:cluster/name
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:region:account:task-definition/name
ECS_SUBNET_IDS=subnet-1,subnet-2,subnet-3
ECS_SECURITY_GROUP_IDS=sg-1,sg-2
ECS_CONTAINER_NAME=builder-container

# --- KAFKA CONFIGURATION ---
KAFKA_CLIENT_ID=docker-deployment-server
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=your_username
KAFKA_PASSWORD=your_password
KAFKA_MECHANISM=scram-sha-256

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# --- CLICKHOUSE CONFIGURATION (FOR LOGS) ---
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your_password

# --- PROXY CONFIGURATION ---
# Base URL for deployed sites (e.g., mysite.localhost:7000)
PROXY_BASE_URL=localhost:7000
# S3 URL for proxy to fetch artifacts
S3_BASE_URL=https://vercel-outputs.s3.es-north-1.amazonaws.com/_ouput

# --- CLIENT (FRONTEND) CONFIGURATION ---
# All NEXT_PUBLIC_ variables are exposed to the browser
NEXT_PUBLIC_MAIN_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:9002
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_PROXY_BASE_URL=localhost:7000
